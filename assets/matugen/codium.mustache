  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#{{colors.on_surface_variant.default.hex_stripped}}",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#{{colors.tertiary.default.hex_stripped}}" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#{{colors.secondary.default.hex_stripped}}" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.operator"],
      "settings": { "foreground": "#{{colors.primary.default.hex_stripped}}" }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#{{colors.primary.default.hex_stripped}}" }
    },
    {
      "scope": ["entity.name.function", "meta.function-call"],
      "settings": { "foreground": "#{{colors.tertiary.default.hex_stripped}}" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#{{colors.secondary.default.hex_stripped}}" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#{{colors.on_surface.default.hex_stripped}}" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#{{colors.on_surface_variant.default.hex_stripped}}" }
    },
    {
      "scope": ["support.function", "support.function.builtin"],
      "settings": { "foreground": "#{{colors.tertiary.default.hex_stripped}}" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#{{colors.primary.default.hex_stripped}}" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#{{colors.secondary.default.hex_stripped}}" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#{{colors.on_surface_variant.default.hex_stripped}}" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#{{colors.error.default.hex_stripped}}" }
    }
  ]
}